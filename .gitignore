# Root .gitignore for Elysian Real Estate CMS

# Operating System Files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Node
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java & Maven
backend/target/
*.class
.mvn/
.idea/
*.iml
.vscode/
*.ipr
*.iws

# Environment variables
.env
!.env.example

# Temporary database files
database/*.db
backend/*.db
